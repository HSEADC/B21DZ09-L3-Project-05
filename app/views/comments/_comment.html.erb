<div id="<%= dom_id comment %>">

  <div class="M_PostComment">

    <div class="Q_Avatar s46"></div>

    <div class="A_PostCommentTexts">
      <div class="PostCommentInfo">
        <p class="A_UserInfoName UN">@<%= comment.user.email.split("@")[0] %></p>
        <!--- <p class="A_PostCommentDate">
        <%#= comment.created_at %>
            сегодня в&nbsp;10:05
        </p> --->
        <% if can? :manage, comment %>
          <div class="PostCommentIcons">
            <%#= link_to "", edit_comment_path(comment), class:"PostCommentIcon Edit" %>
            <%#= link_to "", comment, method: :delete, class:"PostCommentIcon Trash" %>
          </div>
        <% end %>
      </div>
      <p class="A_PostCommentBody"><%= comment.body %></p>
    </div>
  </div>

  <div class="M_PostCommentReplies">
    <% comment.replies.each do |reply| %>
      <%= render reply, partial: "comments/comment", comment: reply, post: post %>
    <% end %>
  </div>

</div>
