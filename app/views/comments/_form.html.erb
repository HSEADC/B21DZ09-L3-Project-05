<%= form_with(model: Comment.new) do |form| %>
  <div>
    <%= form.hidden_field :post_type, value: post.class %>
    <%= form.hidden_field :post_id, value: post.id %>
  </div>

  <% if can? :create, comment %>
    <div class="M_CreateCommentBlock">
      <div class="Q_Avatar s68 CreateComment"></div>

      <%= form.label :"Комментарий", style: "display: none" %>
      <%= form.text_area :body, placeholder: "Ваш комментарий", class: "A_CreateCommentInput" %>

      <%= form.submit :"Отправить", class: "A_Button CreateComment" %>
    </div>
  <% end %>
<% end %>
