<div class="S_IdeaPage Gride">

  <div class="Q_IdeaPageImg">
    <%= image_tag idea.image.url if idea.image.url %>
  </div>

  <div class="O_IdeaPageInfoBlock">

    <div class="W_IdeaPageInfoTop">
      <div class="W_PageInfoAbout Idea">
        <p class="A_PostDate">
          <%#= idea.created_at #%>
          сегодня в&nbsp;10:05
        </p>

        <div class="W_UserInfoOptions">
          <div class="M_UserInfo">
            <div class="Q_Avatar"></div>
            <div class="C_UserInfoNames">
              <p class="A_UserInfoName UN"><%= idea.user.name %></p>
              <p class="A_UserInfoName NN">@<%= idea.user.email.split("@")[0] %></p>
            </div>
          </div>
          <div class="Q_Icon s36 Options"></div>
        </div>

        <div class="W_UserInfoOptions">
          <div class="C_TagsGroup">
            <% idea.tag_list.each do |tag| %>
              <%= link_to tagged_ideas_path(tag), class:"A_Tag Card" do %>
                <%= tag %>
              <% end %>
            <% end %>
          </div>
          <div class="Q_Icon s32 Like"></div>
        </div>
      </div>

      <div class="M_IdeaPageIntoTexts">
        <h3 class="A_IdeaPageInfoTitle"><%= idea.title%></h3>
        <p class="A_IdeaPageInfoDescription"><%= idea.description %></p>
      </div>
    </div>

    <div class="W_IdeaPageInfoComments">
      <p class="A_PageCommentsTitle">Комментарии</p>
      <div class="M_CommentsBlock">
        <div id="poly_comments">
          <% @idea.poly_comments.each do |poly_comment| %>
            <div class="W_IdeaPageComment">
              <%= render poly_comment, idea: @idea %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="W_CreateComment"> <%= render "poly_comments/form", commentable: @idea, poly_comment: PolyComment.new %> </div>
    </div>

  </div>
</div>

<% if @idea.tutorials != [] %>
  <div class="IdeaPostPageSeeAlsoShow">
    <div class="IdeaPostPageSeeAlsoTitle">Научиться так же:</div>
    <div class="IdeaPostPageSeeAlsoCards">
      <% @idea.tutorials.each do |tutorial| %>
        <%= link_to tutorial_path(tutorial), class: "O_TutorialCard" do %>
          <%= render tutorial %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @idea.tutorials == [] %>
  <div class="IdeaPostPageSeeAlsoShow">
    <div class="IdeaPostPageSeeAlsoTitle">Другие идеи:</div>
    <div class="IdeaPostPageSeeAlsoCards">
      <%= link_to idea_path(1), class: "O_IdeaCard PP-1" do %>
        <%= render @recommended_post1 %>
      <% end %>
      <%= link_to idea_path(2), class: "O_IdeaCard PP-2" do %>
        <%= render @recommended_post2 %>
      <% end %>
      <%= link_to idea_path(3), class: "O_IdeaCard PP-3" do %>
        <%= render @recommended_post3 %>
      <% end %>
    </div>
  </div>
<% end %>