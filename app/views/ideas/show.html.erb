<p style="color: green"><%= notice %></p>

<div class="S_IdeaPage">

  <%= link_to :ideas do %>
    <div class="A_NavigationButton Page Back Fixed">
      <div class="Q_Icon s16 Back"></div>
      Назад
    </div>
  <% end %>

  <div class="M_PostOptions Idea">
    <%= link_to "Пожаловаться", welcome_support_url, class: "A_NavigationButton PostOption" %>
    <% if can? :manage, @idea %>
      <%= link_to edit_idea_path(@idea) do %>
        <div class="A_NavigationButton PostOption">
          Редактировать
        </div>
      <% end %>
      <%= button_to "Удалить пост", idea_path(@idea), method: :delete, class: "A_NavigationButton PostOption" %>
    <% end %>
  </div>

  <%= render partial: "ideas/idea_page", locals: {idea: @idea} %>

</div>
