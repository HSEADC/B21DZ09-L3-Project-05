<p style="color: green"><%= notice %></p>

<div class="S_IdeaPage">

  <%= link_to :idea_posts do %>
    <div class="A_NavigationButton Page Back Fixed">
      <div class="Q_Icon s16 Back"></div>
      Назад
    </div>
  <% end %>

  <div class="M_PostOptions Idea">
    <% if can? :manage, @post %>
      <%= link_to edit_idea_post_path(@post) do %>
        <div class="A_NavigationButton PostOption">
          Редактировать
        </div>
      <% end %>
      <%= button_to "Удалить пост", idea_post_path(@post), method: :delete, class: "A_NavigationButton PostOption" %>
      <%= link_to "Пожаловаться", welcome_support_url, class: "A_NavigationButton PostOption" %>
    <% end %>
  </div>

  <%= render partial: "idea_posts/idea_post_page", locals: {post: @post} %>

</div>