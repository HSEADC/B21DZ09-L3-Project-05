<div class="S_LoginPage">

  <div class="A_BannerSignIn"></div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

    <div class="M_Form SignIn">

      <h4 class="A_FormTitle">Вход</h4>

      <div class="C_FormInputs">
        <div class="W_FormInputText">
          <%= f.label :email, class:"A_InputSubtitle" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"A_FormInput", placeholder:"Email" %>
        </div>
        <div class="W_FormInputText">
          <%= f.label :"Введите пароль", class:"A_InputSubtitle"  %>
          <%= f.password_field :password, autocomplete: "current-password", class:"A_FormInput", placeholder:"Пароль" %>
        </div>
      </div>

      <div class="C_FormButtons">
        <%= f.submit "Войти", class:"A_Button SignIn" %>
        <%= render "devise/shared/links" %>
      </div>
    <% end %>

  </div>
</div>
