<%= form_with(model: tutorial) do |form| %>
  <% if tutorial.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(tutorial.errors.count, "error") %>. Пост не может быть сохранён:</h2>

      <ul>
        <% tutorial.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="FormBackground">
    <div class="TutorialNewBanner"></div>
    <div class="IdeaNewForm">

      <div class="TutorialNewFormBlocks">

        <div class="TutorialNewFormLeftBlock">
          <div class="NewFormChooseTypes">

            <a href="/tutorials/new" class="NewFormChooseType Tutorial active">
              <div class="ChooseTypeIconTitle">
                <div class="Q_Icon s32 ChooseTypeTutorial"></div>
                <h5 class="A_ChooseTypeTitle">Туториалы</h5>
              </div>
              <p class="A_ChooseTypeText">Поделитесь своим опытом кастома</p>
            </a>

            <a href="/ideas/new" class="NewFormChooseType Idea">
              <div class="ChooseTypeIconTitle">
                <div class="Q_Icon s32 ChooseTypeIdea"></div>
                <h5 class="A_ChooseTypeTitle">Идея</h5>
              </div>
              <p class="A_ChooseTypeText">Поделитесь идеей кастома</p>
            </a>
          </div>

          <div class="TutorialNewFormRightBlock mobile">
            <div class="NewFormRightBlockAttrs">
              <div class="NewFormAttrsTexts">
                <%= form.label :"Название туториала", class:"TutorialNewFormText" %>
                <p class="NewFormAttrsDescr">Укажите, чему обучает туториал</p>
              </div>
              <%= form.text_field :title, placeholder:"Например: Как расписать кеды", class:"NewFormField" %>
            </div>

            <div class="NewFormRightBlockAttrs">
              <div class="NewFormAttrsTexts">
                <%= form.label :"Теги", class:"TutorialNewFormText" %>
                <p class="NewFormAttrsDescr">Выберите из доступных</p>
              </div>
              <%= form.text_field :tag_list, value: tutorial.tag_list.join(", "), placeholder:"Например: обувь, роспись, кожа", class:"NewFormField"  %>
            </div>

            <div class="NewFormRightBlockAttrs">
              <div class="NewFormAttrsTexts">
                <%= form.label :"Описание туториала", class:"TutorialNewFormText" %>
                <p class="NewFormAttrsDescr">Кратко расскажите, о чем туториал</p>
              </div>
              <%= form.text_area :description, placeholder:"Расскажите про ваш кастом", class:"NewFormField bigtext" %>
            </div>

            <div class="FormButtons">
              <%= link_to "Отменить", :back, class:"FormButton Back" %>
              <%= form.submit :"Опубликовать", class:"FormButton Post" %>
            </div>
          </div>

          <div class="NewTutorialImg">
            <%= form.label :"Добавьте обложку туториала", class:"TutorialNewFormText" %>
            <%= form.file_field :image %>
          </div>

          <div class="NewTutorialContent">
            <%= form.rich_text_area :content, class:"NewTutorialContentEditor" %>
          </div>
        </div>

        <div class="TutorialNewFormRightBlock desk">
          <div class="NewFormRightBlockAttrs">
            <div class="NewFormAttrsTexts">
              <%= form.label :"Название туториала", class:"TutorialNewFormText" %>
              <p class="NewFormAttrsDescr">Укажите, чему обучает туториал</p>
            </div>
            <%= form.text_field :title, placeholder:"Например: Как расписать кеды", class:"NewFormField" %>
          </div>

          <div class="NewFormRightBlockAttrs">
            <div class="NewFormAttrsTexts">
              <%= form.label :"Теги", class:"TutorialNewFormText" %>
              <p class="NewFormAttrsDescr">Выберите из доступных</p>
            </div>
            <%= form.text_field :tag_list, value: tutorial.tag_list.join(", "), placeholder:"Например: обувь, роспись, кожа", class:"NewFormField"  %>
          </div>

          <div class="NewFormRightBlockAttrs">
            <div class="NewFormAttrsTexts">
              <%= form.label :"Описание туториала", class:"TutorialNewFormText" %>
              <p class="NewFormAttrsDescr">Кратко расскажите, о чем туториал</p>
            </div>
            <%= form.text_area :description, placeholder:"Расскажите про ваш кастом", class:"NewFormField bigtext" %>
          </div>

          <div class="FormButtons">
            <%= link_to "Отменить", :back, class:"FormButton Back" %>
            <%= form.submit :"Опубликовать", class:"FormButton Post" %>
          </div>
        </div>
      </div>

    </div>
  </div>
<% end %>