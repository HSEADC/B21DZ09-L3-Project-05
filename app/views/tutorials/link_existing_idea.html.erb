<div class="S_IdeaCardsPageLink">

  <h5 class="LinkContentTitle">Выберите, какую идею привязать к туториалу "<%= @tutorial.title %>"</h5>
  <div class="C_IdeaCards">
    <% if @ideas.any? %>
      <% @ideas.each do |idea| %>
        <div class="O_IdeaCard">
          <%= button_to link_idea_tutorial_path(@tutorial, idea_id: idea.id), method: :post do %>
            <%= render idea %>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <p>Нет доступных для привязки идей</p>
    <% end %>
  </div>

  <%#= link_to 'Back', @tutorial %>
</div>
