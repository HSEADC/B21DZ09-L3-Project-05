<div class="S_TutorialPageContent">

  <div class="W_PageInfoAbout Tutorial">

    <div class="W_UserInfoOptions tutorial1">
      <div class="M_UserInfo">
        <div class="Q_Avatar s62"></div>
        <div class="C_UserInfoNames">
          <p class="A_UserInfoName UN"><%= tutorial.user.name %></p>
          <p class="A_UserInfoName NN">@<%= tutorial.user.email.split("@")[0] %></p>
        </div>
      </div>
      <div class="Q_Icon s36 Options"></div>
    </div>

    <div class="W_UserInfoOptions timeLike">
      <div class="Q_Icon s32 Like"></div>
      <p class="A_PostDate">
        <%#= tutorial.created_at #%>
        сегодня в&nbsp;10:05
      </p>
    </div>

    <div class="C_TagsGroup">
      <% tutorial.tag_list.each do |tag| %>
        <%= link_to tagged_tutorials_path(tag), class:"A_Tag Card" do %>
          <%= tag %>
        <% end %>
      <% end %>
    </div>

  </div>

  <div class="M_TutorialPageTitleDescription">
    <h3 class="A_TutorialPageTitle"><%= tutorial.title%></h3>
    <p class="A_TutorialPageDescription"><%= tutorial.description %></p>
  </div>

  <div class="Q_TutorialPageImg">
    <%= image_tag tutorial.image.url %>
  </div>

  <div class="M_TutorialPageContent">
    <%= tutorial.content %>
  </div>

  <!--- --->

  <!--- --->

  <div class="W_TutorialPageContacts">
    <div class="M_TutorialPageTexts">
      <h5 class="A_TutorialPageSubtitle">Контакты автора</h5>
      <p class="A_TutorialPageText">Можете посмотреть больше моих работ по ссылкам: портфолио на бехансе и блог в телеге. Подписывайтесь, ставьте лайки и давайте кастомить вместе! :) А ещё мой мерч доступен для заказа</p>
    </div>

    <div class="W_UserInfoOptions">
      <div class="M_UserInfo">
        <div class="Q_Avatar s62"></div>
        <div class="C_UserInfoNames">
          <p class="A_UserInfoName UN"><%= tutorial.user.name %></p>
          <p class="A_UserInfoName NN">@<%= tutorial.user.email.split("@")[0] %></p>
        </div>
      </div>
      <div class="C_SocialNetworks">
        <a class="Q_SocialNetwork VK Black" href="https://vk.com/lchok" target="_blank"></a>
        <a class="Q_SocialNetwork TG Black" href="https://t.me/loochok_media" target="_blank"></a>
      </div>
    </div>
  </div>
</div>
