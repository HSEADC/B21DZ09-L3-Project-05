<div class="M_HeaderSearch" data-controller="search">
  <%= form_with url: welcome_search_path, method: :get, data: { search_target: "searchForm" } do |f| %>
    <div class="W_SearchHidden">
      <%= f.text_field :search, class:"A_SearchField", placeholder:"ПОИСК...", data: { search_target: "searchField", action: "input->search#GetData" } %>
      <div class="Q_Icon s26 Cross onsearch"></div>
    </div>
    <div class="Q_Icon s32 Search NavDesk Fake"></div>
    <%= f.submit "", class:"Q_Icon s32 Search NavDesk Real" %>

    <%= f.submit "Поиск", data: { search_target: "submitButton", turbo_stream: true }, hidden: true %>
  <% end %>

  <div class="O_HeaderSearchPreview" id="search_preview" data-search-target="searchPreview"></div>
</div>