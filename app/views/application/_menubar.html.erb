<% if user_signed_in? && current_user.admin %>

  <div class="M_NavCreateNewPosts">
    <%= link_to "+Новая идея", new_admin_idea_post_path, class: "A_NavigationButton createNewPost" %>
    <%= link_to "+Новый туториал", new_admin_tutorial_post_path, class: "A_NavigationButton createNewPost" %>
  </div>

  <nav class="O_Header">
    <div class="Q_Icon s32 MenuMob"></div>

    <div class="C_HeaderSections Desk">
      <%= link_to "Главная", root_url, class: "A_NavigationButton" %>
      <%#= link_to "Все посты", admin_posts_url, class: "A_NavigationButton" %>
      <%= link_to "Идеи", admin_idea_posts_url, class: "A_NavigationButton" %>
      <%= link_to "Туториалы", admin_tutorial_posts_url, class: "A_NavigationButton" %>
      <%= link_to "Комментарии", admin_comments_url, class: "A_NavigationButton" %>
      <%= link_to "Подписки", admin_subscriptions_url, class: "A_NavigationButton" %>
    </div>

    <%#= link_to "ÒÒ", root_url, class: "A_Logo" %>

    <div class="C_HeaderSections">
      <div class="A_NavigationButton NewPost">
        <div class="Q_Icon s20 CreatePost"></div>
        Новый пост</div>

      <%#= link_to "", root_url, class: "Q_Icon s32 Search NavDesk" %>
      <%= render 'search_form' %>
      <%#= link_to "", root_url, class: "Q_NavUser" %>
      <%= link_to "", edit_user_registration_path, class: "Q_AvatarAdmin" %>

      <%#= link_to "Выйти", destroy_user_session_path, method: :delete, class: "A_NavigationButton" %>
    </div>
  </nav>

  <div class="M_MobileMenu">
    <div class="C_MobileMenuPages">
      <%= link_to "Главная", root_url, class: "A_MobileMenuSection" %>
      <%#= link_to "Все посты", admin_posts_url, class: "A_MobileMenuSection" %>
      <%= link_to "Идеи", admin_idea_posts_url, class: "A_MobileMenuSection" %>
      <%= link_to "Туториалы", admin_tutorial_posts_url, class: "A_MobileMenuSection" %>
      <%= link_to "Комментарии", admin_comments_url, class: "A_MobileMenuSection" %>
      <%= link_to "Подписки", admin_subscriptions_url, class: "A_MobileMenuSection" %>
    </div>
    <div class="C_MobileMenuCreate">
      <%= link_to "+Новая идея", new_admin_idea_post_path, class: "A_MobileMenuSection MobileMenuCreate" %>
      <%= link_to "+Новый туториал", new_admin_idea_post_path, class: "A_MobileMenuSection MobileMenuCreate" %>
    </div>
  </div>
<% end %>

