<%= form_with(model: poly_comment) do |form| %>
  <% if poly_comment.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(poly_comment.errors.count, "error") %> prohibited this comment from being saved:</h2>

      <ul>
        <% poly_comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :commentable_type, value: commentable.class.base_class %>
  <%= form.hidden_field :commentable_id, value: commentable.id %>

  <% if can? :create, poly_comment %>
    <div class="M_CreateCommentBlock">
      <div class="Q_Avatar s68 CreateComment"></div>

      <%= form.label :"Комментарий", style: "display: none" %>
      <%= form.text_area :body, placeholder: "Ваш комментарий", class: "A_CreateCommentInput" %>

      <%= form.submit :"Отправить", class: "A_Button CreateComment" %>
    </div>
  <% end %>
<% end %>
