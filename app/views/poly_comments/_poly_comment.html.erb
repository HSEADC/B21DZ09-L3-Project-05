<div id="<%= dom_id poly_comment %>">

  <div class="M_PostComment">

    <div class="Q_Avatar s46"></div>

    <div class="A_PostCommentTexts">
      <div class="PostCommentInfo">
        <p class="A_UserInfoName UN">@<%= poly_comment.user.email.split("@")[0] %></p>
        <!--- <p class="A_PostCommentDate">
        <%#= poly_comment.created_at %>
            сегодня в&nbsp;10:05
        </p> --->
        <%# if can? :manage, poly_comment %>
        <div class="PostCommentIcons">
          <%#= link_to "", edit_poly_comment_path(poly_comment), class:"PostCommentIcon Edit" %>
          <%#= link_to "", poly_comment, method: :delete, class:"PostCommentIcon Trash" %>
        </div>
        <%# end %>
      </div>
      <p class="A_PostCommentBody"><%= poly_comment.body %></p>
    </div>
  </div>
</div>
